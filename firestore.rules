rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 2. Assets collection path rules
    match /assets/{assetId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidId(assetId) && isValidAsset(incoming());
      allow update: if isEmailVerified() && isValidId(assetId) && isValidAsset(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isEmailVerified() && isValidId(assetId);
    }

    // 3. Settings collection path rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isEmailVerified() && isValidId(settingId);
    }

    // Standalone entity validator
    function isValidAsset(data) {
      return data.keys().hasAll(['id', 'type', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.type is string && (data.type == 'tanah' || data.type == 'kendaraan' || data.type == 'bangunan')
        && (data.createdAt is int || data.createdAt is timestamp);
    }
  }
}
